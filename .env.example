NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-stable-random-secret-at-least-32-characters
DATA_KEY=replace-with-a-different-stable-random-secret-at-least-32-characters
LOCAL_WORKSPACE_DIR=/tmp/ai-code-chat-workspaces

# Optional server-wide API keys. User-specific keys can be entered in Settings.
OPENUNCENSORED_API_KEY=
VENICE_API_KEY=
