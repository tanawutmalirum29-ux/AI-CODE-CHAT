NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-stable-random-secret-at-least-32-characters
DATA_KEY=replace-with-a-different-stable-random-secret-at-least-32-characters
LOCAL_WORKSPACE_DIR=/tmp/ai-code-chat-workspaces

# Optional server-wide API keys. User-specific keys can be entered in Settings.
OPENUNCENSORED_API_KEY=
VENICE_API_KEY=

# Locally Uncensored engine (optional server-wide profile). Must be a public HTTPS endpoint
# (tunnel or GPU server) when the backend runs on AWS Amplify.
LU_CHAT_BASE_URL=
LU_CHAT_TOKEN=
COMFYUI_BASE_URL=
COMFYUI_TOKEN=
# Legacy aliases remain supported:
LU_COMFY_BASE_URL=
LU_COMFY_TOKEN=
# Engine network policy. Leave unset on Amplify.
ENGINE_ALLOW_HTTP=
ENGINE_HOST_ALLOWLIST=
ENGINE_MAX_PER_SESSION=5
